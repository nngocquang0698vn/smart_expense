# Copy this file to .env for local development.
# Never commit a real .env file or real secrets.

OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional demo gate. If set, clients must send header:
# X-Demo-Token: your-demo-token
DEMO_TOKEN=

# Optional comma-separated origins for Flutter Web/PWA.
# Example: http://localhost:5173,https://your-flutter-demo.example.com
ALLOWED_ORIGINS=

# Optional regex for dynamic preview deploy origins.
# Example supports Cloudflare Pages previews such as:
# https://ba306eb1.smart-expense.pages.dev
ALLOWED_ORIGIN_REGEX=https://.*\.smart-expense\.pages\.dev

# Optional model overrides.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_PARSE_MODEL=gpt-4o-mini
